{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sadmoneyapp",
  "version": "0.2.21",
  "identifier": "com.mkudm.sadmoneyapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sadmoneyapp",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/mkudmi/sadmoneyapp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzRTM5N0M5RjMwNEIyMzMKUldRenNnVHp5WmZqdzJ1dEt1VFVURWVVZk9nc0dGQ2gvZE1BNlJ2RlFDM1hVSXAwZHM1TS95N1oK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

