{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sadmoneyapp",
  "version": "0.1.2",
  "identifier": "com.mkudm.sadmoneyapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sadmoneyapp",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/mkudmi/sadmoneyapp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQ0IyRDY0NDlFRTU5MjYKUldRbVdlNUpaQzNMeTd0VlNKcVVpQ1NvMlNFeTA2d1hnZGJVdEpoOGNjSUI0MW52ZHhuOUtoQXkK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
